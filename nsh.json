{
  "name": "Listenook",
  "id": "app.capyvibe.listenook",
  "version": "2.0.3",
  "build": 1,
  "appearance": "system",
  "theme": "theme.json",
  "rust": ".",
  "root": "App",
  "updater": {
    "github": "tacshi/Listenook",
    "publicKey": "vShKA+XS7DjUOBruFx309Mkw5vMDu13nKUbAFwn5tbk="
  },
  "icon": {
    "macos": "icon.png",
    "ios": "icon-full.png",
    "android": "icon-full.png",
    "windows": "icon-full.png",
    "linux": "icon-full.png"
  },
  "ios": {
    "infoPlist": {
      "MinimumOSVersion": "18.0",
      "UIFileSharingEnabled": true,
      "NSLocalNetworkUsageDescription": "Listenook finds your other devices on this network to sync your Library with them.",
      "LSSupportsOpeningDocumentsInPlace": true,
      "UIBackgroundModes": [
        "audio"
      ],
      "ITSAppUsesNonExemptEncryption": false
    }
  },
  "singleInstance": true,
  "fileTypes": [
    {
      "name": "Video",
      "extensions": [
        "mp4",
        "m4v",
        "mov",
        "mkv",
        "webm",
        "avi"
      ],
      "mimeTypes": [
        "video/mp4",
        "video/x-m4v",
        "video/quicktime",
        "video/x-matroska",
        "video/webm",
        "video/x-msvideo"
      ],
      "contentTypes": [
        "public.movie"
      ]
    },
    {
      "name": "Audio",
      "extensions": [
        "mp3",
        "wav",
        "m4a",
        "ogg"
      ],
      "mimeTypes": [
        "audio/mpeg",
        "audio/wav",
        "audio/mp4",
        "audio/ogg"
      ],
      "contentTypes": [
        "public.audio"
      ]
    }
  ]
}
